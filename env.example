# Copy to .env.local for local work. In Vercel, configure the same keys in
# Project Settings > Environment Variables for Production and/or Preview.
# When FRONTEND_DEMO_MODE=false, replace empty required values with real settings.

# Frontend previews use dummy credentials by default. Set false for a real
# backend deployment, then fill in the required configuration below.
FRONTEND_DEMO_MODE="true"

# Database
MONGODB_URI=""
MONGODB_DB=""

# Email
SENDER_EMAIL=""
SENDER_EMAIL_PASSWORD=""
ADMIN_RECEIVER_MAIL=""
SMTP_PORT="465"
EMAIL_SERVICE="Gmail"
SMTP_HOST="smtp.gmail.com"

# URLs: set enviroment="production" and production_url to your site's URL
# in Vercel. Keep the legacy spelling "enviroment" used by the application.
enviroment="development"
production_url=""
local_url="http://localhost:3000"

# Server secrets: use distinct random values, not the example key names.
# GENERAL_SECRET_KEY must have at least 32 ASCII characters for AES-256.
TOKEN_SECRET_KEY=""
SECRET_KEY=""
REFRESH_SECRET_KEY=""
GENERAL_SECRET_KEY=""
INTERNAL_SECRET=""

# Used by the existing browser payload encryption contract. This value is
# public in the client bundle; keep it distinct from every server secret.
NEXT_PUBLIC_SERVICE_SECRET=""

# Optional Contentful integration: leave all five empty to disable it.
# When enabling it, configure all five values together.
CONTENTFUL_SPACE_ID=""
CONTENTFUL_ENVIRONMENT=""
CONTENTFUL_DELIVERY_ACCESS_TOKEN=""
CONTENTFUL_PREVIEW_ACCESS_TOKEN=""
CONTENTFUL_PREVIEW_SECRET=""
CONTENTFUL_HOMEPAGE_ENTRY_ID=""
CONTENTFUL_GLOBAL_BROCHURE_ENTRY_ID=""
USECONTENTSTACK="false"
USEAWS="false"
# Optional homepage film. Use a public path or an HTTPS MP4/WebM URL.
# Example: copy your video to public/videos/bes-expo.mp4 and set
# HOMEPAGE_VIDEO_URL="/videos/bes-expo.mp4". Restart/redeploy after changes.
HOMEPAGE_VIDEO_URL=""
HOMEPAGE_VIDEO_POSTER=""
HOMEPAGE_VIDEO_CAPTIONS=""
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_S3_CAROUSEL_PREFIX="homepage/carousel"
AWS_CDN_BASE_URL=""
